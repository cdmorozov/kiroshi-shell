/* Night City HUD launcher */
* {
  bg: #081020e6; surface: #0e1a30; line: #16233a;
  fg: #c9d1db; muted: #8fa3b8; accent: #4fa3ae; alert: #e60000;
  font: "Rajdhani Bold 14";
  background-color: transparent;
  text-color: @fg;
}
window {
  width: 560px;
  background-color: @bg;
  border: 0 0 0 3px;
  border-color: @accent;
  padding: 0;
}
mainbox { children: [ textbox-title, inputbar, listview ]; spacing: 0; }
textbox-title {
  content: "NETRUNNER // QUICKHACK MENU";
  expand: false;
  background-color: @surface;
  text-color: @muted;
  font: "Rajdhani Bold 12";
  padding: 8px 16px;
  border: 0 0 1px 0;
  border-color: @line;
}
inputbar { children: [ prompt, entry ]; padding: 12px 16px; spacing: 10px; }
prompt { text-color: @alert; }
entry  { placeholder: "type to search..."; placeholder-color: #3a4a63; cursor: text; }
listview { lines: 8; columns: 1; fixed-height: true; padding: 4px 0 10px 0; scrollbar: false; }
element { padding: 7px 16px; spacing: 12px; border: 0 0 0 2px; border-color: transparent; }
element normal.normal, element alternate.normal { text-color: @muted; }
element selected.normal {
  background-color: #4fa3ae1f;
  border-color: @accent;
  text-color: @fg;
}
element-icon { size: 22px; }
element-text { vertical-align: 0.5; text-color: inherit; }
