 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#3a4a63",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage.type",
    "storage.modifier",
    "keyword.control"
   ],
   "settings": {
    "foreground": "#4fa3ae"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation"
   ],
   "settings": {
    "foreground": "#8fa3b8"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ],
   "settings": {
    "foreground": "#7ec8a0"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.character"
   ],
   "settings": {
    "foreground": "#ffa62b"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ],
   "settings": {
    "foreground": "#7fbcc5"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "storage.type.primitive"
   ],
   "settings": {
    "foreground": "#7a9bc7"
   }
  },
  {
   "scope": [
    "variable",
    "variable.other"
   ],
   "settings": {
    "foreground": "#c9d1db"
   }
  },
  {
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#b5c3d1",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "variable.language",
    "support.variable",
    "entity.name.tag"
   ],
   "settings": {
    "foreground": "#ff3ea5"
   }
  },
  {
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#ffa62b"
   }
  },
  {
   "scope": [
    "constant.other",
    "variable.other.constant",
    "variable.other.enummember"
   ],
   "settings": {
    "foreground": "#ffd23f"
   }
  },
  {
   "scope": [
    "invalid"
   ],
   "settings": {
    "foreground": "#e60000"
   }
  },
  {
   "scope": [
    "markup.heading"
   ],
   "settings": {
    "foreground": "#4fa3ae",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.inline.raw",
    "markup.fenced_code"
   ],
   "settings": {
    "foreground": "#7ec8a0"
   }
  }
 ],
 "semanticHighlighting": true
}